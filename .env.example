# === 必填: Telegram 推送 ===
TELEGRAM_BOT_TOKEN=在此填入你的BotToken
TELEGRAM_CHAT_ID=在此填入你的ChatID

# === 必填: Solana RPC (用于获取代币持仓) ===
# 推荐 Helius 免费 tier (10万次/天, 30秒注册):
#   1. 访问 https://www.helius.dev/ → Sign Up
#   2. 创建 API Key
#   3. RPC URL 格式如下:
SOLANA_RPC_URL=https://mainnet.helius-rpc.com/?api-key=在此填入你的Helius_API_Key
